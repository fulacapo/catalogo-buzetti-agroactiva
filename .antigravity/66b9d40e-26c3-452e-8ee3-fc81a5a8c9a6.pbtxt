  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, Suspense, useRef } from \'react\';\nimport { Canvas } from \'@react-three/fiber\';\nimport { Environment, ContactShadows } from \'@react-three/drei\';\nimport { Scene } from \'./components/Scene\';\nimport { useHandTracking } from \'./hooks/useHandTracking\';\nimport { cn } from \'./lib/utils\';\nimport { Hand, ArrowLeftRight, Minimize, Loader2, Sparkles } from \'lucide-react\';\n\nexport default function App() {\n  const [products, setProducts] = useState<any[]>([]);\n  const [metadata, setMetadata] = useState<any>(null);\n  const [activeIndex, setActiveIndex] = useState(0);\n  const [showDetails, setShowDetails] = useState(false);\n  const [enrichedInfo, setEnrichedInfo] = useState<string | null>(null);\n  const [isLoadingInfo, setIsLoadingInfo] = useState(false);\n\n  // Initialize MediaPipe Hand Tracking\n  const { videoRef, gesture, isInitializing, error } = useHandTracking();\n  \n  // Ref to avoid duplicate API calls during rapid gestures\n  const lastFetchedCode = useRef<string | null>(null);\n\n  useEffect(() => {\n    // Fetch local database compiled from the server\n    fetch(\'/api/products\')\n      .then(res => res.json())\n      .then(data => {\n        setProducts(data.products || []);\n        setMetadata(data.metadata || {});\n      })\n      .catch(err => console.error(\"Failed to load products:\", err));\n  }, []);\n\n  // Handle Gestures\n  useEffect(() => {\n    if (products.length === 0) return;\n\n    if (gesture === \'SWIPE_LEFT\') {\n      setActiveIndex(prev => Math.min(prev + 1, products.length - 1));\n      setShowDetails(false); // Close details on swipe\n    } else if (gesture === \'SWIPE_RIGHT\') {\n      setActiveIndex(prev => Math.max(prev - 1, 0));\n      setShowDetails(false);\n    } else if (gesture === \'PINCH\') {\n      if (!showDetails) {\n         setShowDetails(true);\n      }\n    } else if (gesture === \'OPEN_HAND\') {\n       setShowDetails(false);\n    }\n  }, [gesture, products.length, showDetails]);\n\n  // Fetch enriched info when details are opened for a specific product\n  useEffect(() => {\n    const fetchEnrichedInfo = async () => {\n      if (!showDetails || products.length === 0) return;\n      \n      const currentProduct = products[activeIndex];\n      if (!currentProduct || currentProduct.codigo === lastFetchedCode.current) return;\n\n      setIsLoadingInfo(true);\n      setEnrichedInfo(null);\n      lastFetchedCode.current = currentProduct.codigo;\n\n      try {\n        const res = await fetch(\'/api/enrich\', {\n          method: \'POST\',\n          headers: { \'Content-Type\': \'application/json\' },\n          body: JSON.stringify({ \n            productName: currentProduct.descripcion,\n            code: currentProduct.codigo\n          })\n        });\n        const data = await res.json();\n        setEnrichedInfo(data.info);\n      } catch (err) {\n         console.error(\"Error fetching AI info:\", err);\n         setEnrichedInfo(\"Error de conexi\303\263n al buscar informaci\303\263n adicional.\");\n      } finally {\n        setIsLoadingInfo(false);\n      }\n    };\n\n    fetchEnrichedInfo();\n  }, [showDetails, activeIndex, products]);\n\n\n  // Calculate Progress\n  const progress = products.length > 0 ? ((activeIndex + 1) / products.length) * 100 : 0;\n  const currentProduct = products[activeIndex];\n\n  return (\n    <div className=\"relative w-full h-screen bg-slate-950 overflow-hidden font-sans\">\n      \n      {/* 3D Canvas Layer */}\n      <div className=\"absolute inset-0 z-0\">\n        <Canvas camera={{ position: [0, 0, 8], fov: 50 }}>\n           <color attach=\"background\" args={[\'#020617\']} />\n           <ambientLight intensity={0.5} />\n           <spotLight position={[10, 10, 10]} angle={0.15} penumbra={1} intensity={1} />\n           <Suspense fallback={null}>\n             <Environment preset=\"city\" />\n             <Scene products={products} activeIndex={activeIndex} />\n             <ContactShadows resolution={1024} scale={20} blur={2} opacity={0.5} far={10} color=\"#000000\" />\n           </Suspense>\n        </Canvas>\n      </div>\n\n      {/* Floating Header */}\n      <header className=\"absolute top-0 left-0 right-0 p-6 z-10 flex justify-between items-start pointer-events-none\">\n        <div className=\"glass px-6 py-4 rounded-2xl flex flex-col pointer-events-auto\">\n          <h1 className=\"text-2xl font-display font-bold tracking-tight text-white m-0\">\n            {metadata?.fabricante || \'DUSP\'}\n          </h1>\n          <p className=\"text-sm font-mono text-slate-400 mt-1 uppercase tracking-wider\">\n             {metadata?.descripcion || \'Cat\303\241logo Digital\'}\n          </p>\n        </div>\n\n        {/* Gesture Status Indicator */}\n        <div className=\"glass px-4 py-3 rounded-xl flex items-center gap-3\">\n           <div className=\"relative w-12 h-12 overflow-hidden rounded-lg bg-black object-cover shrink-0 ring-1 ring-white/10\">\n              <video \n                ref={videoRef} \n                autoPlay \n                playsInline \n                muted \n                className=\"absolute inset-0 w-full h-full object-cover transform -scale-x-100 opacity-60\" \n              />\n              {isInitializing && (\n                <div className=\"absolute inset-0 flex items-center justify-center bg-black/80\">\n                  <Loader2 className=\"w-4 h-4 text-white animate-spin\" />\n                </div>\n              )}\n           </div>\n           \n           <div className=\"flex flex-col min-w-[120px]\">\n             <span className=\"text-xs font-mono text-slate-400 uppercase tracking-wider\">Gesture</span>\n             <span className={cn(\n               \"text-sm font-medium\",\n               gesture !== \'IDLE\' ? \"text-emerald-400\" : \"text-white\"\n             )}>\n                {isInitializing ? \'INICIANDO VISI\303\223N...\' : error ? \'C\303\201MARA REQUERIDA\' : gesture.replace(\'_\', \' \')}\n             </span>\n           </div>\n        </div>\n      </header>\n\n      {/* Product Details Overlay (Triggered by PINCH) */}\n      <div className={cn(\n        \"absolute right-8 top-32 bottom-32 w-96 glass rounded-2xl p-6 flex flex-col z-20 transition-all duration-500 transform shadow-2xl\",\n        showDetails ? \"translate-x-0 opacity-100\" : \"translate-x-[120%] opacity-0 pointer-events-none\"\n      )}>\n        {currentProduct && (\n          <>\n            <div className=\"flex-1 overflow-y-auto pr-2 scrollbar-hide\">\n               <div className=\"inline-flex px-2 py-1 bg-white/10 rounded-md text-xs font-mono text-slate-300 mb-4\">\n                  {currentProduct.categoria || \'Repuesto\'}\n               </div>\n               \n               <h2 className=\"text-3xl font-display font-bold text-white leading-tight mb-2\">\n                 Ref. {currentProduct.codigo}\n               </h2>\n               \n               <p className=\"text-slate-300 font-medium mb-6\">\n                 {currentProduct.descripcion}\n               </p>\n               \n               {/* Technical Specs Array */}\n               {currentProduct.medidas && (\n                 <div className=\"mb-6\">\n                    <h3 className=\"text-xs font-mono text-slate-400 uppercase mb-2\">Medidas</h3>\n                    <p className=\"text-sm border-l-2 border-emerald-500 pl-3\">{currentProduct.medidas}</p>\n                 </div>\n               )}\n               \n               {currentProduct.aplicaciones && currentProduct.aplicaciones.length > 0 && (\n                 <div className=\"mb-6\">\n                    <h3 className=\"text-xs font-mono text-slate-400 uppercase mb-2\">Aplicaciones</h3>\n                    <ul className=\"flex flex-wrap gap-2\">\n                      {currentProduct.aplicaciones.slice(0,6).map((app: string, idx: number) => (\n                        <li key={idx} className=\"bg-slate-800 text-xs px-2 py-1 rounded border border-slate-700\">\n                          {app}\n                        </li>\n                      ))}\n                      {currentProduct.aplicaciones.length > 6 && (\n                         <li className=\"bg-slate-800/50 text-xs px-2 py-1 rounded border border-slate-700/50 text-slate-400\">\n                           +{currentProduct.aplicaciones.length - 6} m\303\241s\n                         </li>\n                      )}\n                    </ul>\n                 </div>\n               )}\n\n               {/* AI ENRICHED INFO */}\n               <div className=\"mt-8 p-4 rounded-xl bg-indigo-500/10 border border-indigo-500/20 relative overflow-hidden\">\n                  <div className=\"absolute top-0 right-0 p-3 opacity-20\"><Sparkles className=\"w-12 h-12 text-indigo-400\" /></div>\n                  <h3 className=\"text-xs font-mono text-indigo-300 uppercase mb-3 flex items-center gap-2\">\n                     <Sparkles className=\"w-3 h-3\" /> Informaci\303\263n din\303\241mica\n                  </h3>\n                  \n                  {isLoadingInfo ? (\n                    <div className=\"flex text-slate-400 text-sm items-center gap-2\">\n                       <Loader2 className=\"w-4 h-4 animate-spin text-indigo-400\" /> Consultando web...\n                    </div>\n                  ) : enrichedInfo ? (\n                    <p className=\"text-sm text-slate-200 leading-relaxed relative z-10\">{enrichedInfo}</p>\n                  ) : (\n                    <p className=\"text-sm text-slate-500\">No hay informaci\303\263n adicional disponible.</p>\n                  )}\n               </div>\n            </div>\n            \n            <div className=\"pt-4 mt-4 border-t border-white/10 flex justify-between items-center text-xs font-mono text-slate-400\">\n               <span>ABRE LA MANO PARA CERRAR</span>\n               <Minimize className=\"w-4 h-4\" />\n            </div>\n          </>\n        )}\n      </div>\n\n      {/* Bottom Navigation Status */}\n      <div className=\"absolute bottom-10 left-1/2 transform -translate-x-1/2 z-10 flex flex-col items-center pointer-events-none\">\n        \n        {/* Progress Bar */}\n        <div className=\"w-64 h-1 bg-white/10 rounded-full overflow-hidden mb-4\">\n           <div \n             className=\"h-full bg-white transition-all duration-300 ease-out\" \n             style={{ width: `${progress}%` }}\n           />\n        </div>\n\n        {/* Instructions */}\n        <div className=\"glass px-6 py-2 rounded-full flex gap-6 mt-2\">\n          <div className=\"flex items-center gap-2 text-xs font-mono text-slate-300\">\n             <ArrowLeftRight className=\"w-4 h-4\" />\n             DESLIZA PARA NAVEGAR\n          </div>\n          <div className=\"w-px h-4 bg-white/20\"></div>\n          <div className=\"flex items-center gap-2 text-xs font-mono text-slate-300\">\n             <Hand className=\"w-4 h-4\" />\n             PELLI\303\221ISCA PARA DETALLES\n          </div>\n        </div>\n      </div>\n\n    </div>\n  );\n}"
    }
