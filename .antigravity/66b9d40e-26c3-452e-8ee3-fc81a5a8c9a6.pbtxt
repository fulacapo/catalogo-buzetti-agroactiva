    replacement_infos {
      original_chunk {
        target_content: "  // Detect gestures based on landmarks\n  const processLandmarks = useCallback((result: HandLandmarkerResult) => {\n    if (result.landmarks.length > 0) {\n      const hand = result.landmarks[0];\n      \n      // Calculate distance between thumb tip (4) and index finger tip (8)\n      const thumbTip = hand[4];\n      const indexTip = hand[8];\n      \n      const distance = Math.sqrt(\n        Math.pow(thumbTip.x - indexTip.x, 2) + \n        Math.pow(thumbTip.y - indexTip.y, 2)\n      );\n\n      const currentTime = Date.now();\n      const currentX = hand[0].x; // Wrist position X\n\n      // SWIPE DETECTION\n      if (prevPositionRef.current) {\n        const dx = currentX - prevPositionRef.current.x;\n        const dt = currentTime - prevPositionRef.current.time;\n        const velocity = dx / dt;\n        \n        // Only trigger swipe if velocity is high and enough time passed since last swipe\n        if (Math.abs(velocity) > 0.003 && dt > 200) {\n          if (velocity < -0.003) { // Hand moved left (mirrored camera could affect this, we assume standard representation)\n             setGesture(\'SWIPE_LEFT\');\n             prevPositionRef.current = { x: currentX, time: currentTime };\n             return;\n          } else if (velocity > 0.003) { // Hand moved right\n             setGesture(\'SWIPE_RIGHT\');\n             prevPositionRef.current = { x: currentX, time: currentTime };\n             return; // Debounce\n          }\n        }\n      }\n      \n      // PINCH DETECTION\n      if (distance < 0.05) {\n        setGesture(\'PINCH\');\n      } else if (distance > 0.15) {\n        setGesture(\'OPEN_HAND\');\n      } else {\n        setGesture(\'IDLE\'); // Revert to idle if nothing else \n      }\n\n      // Update prev position continuously for smooth velocity tracking, unless we just triggered a swipe\n      if (!prevPositionRef.current || (currentTime - prevPositionRef.current.time) > 50) {\n         prevPositionRef.current = { x: currentX, time: currentTime };\n      }\n      \n    } else {\n      setGesture(\'IDLE\');\n      prevPositionRef.current = null;\n    }\n  }, []);"
        replacement_content: "  // Detect gestures based on landmarks\n  const processLandmarks = useCallback((result: HandLandmarkerResult) => {\n    if (result.landmarks.length > 0) {\n      const hand = result.landmarks[0];\n      const thumbTip = hand[4];\n      const indexTip = hand[8];\n      \n      const distance = Math.sqrt(\n        Math.pow(thumbTip.x - indexTip.x, 2) + \n        Math.pow(thumbTip.y - indexTip.y, 2)\n      );\n\n      const now = Date.now();\n      const currentX = hand[0].x; // Wrist position X\n\n      // Sync custom cursor DOM element\n      if (cursorRef?.current) {\n          cursorRef.current.style.opacity = \'1\';\n          const cx = (1 - indexTip.x) * window.innerWidth;\n          const cy = indexTip.y * window.innerHeight;\n          cursorRef.current.style.left = `${cx}px`;\n          cursorRef.current.style.top = `${cy}px`;\n          \n          if (distance < 0.06) {\n              cursorRef.current.style.transform = \'translate(-50%, -50%) scale(0.6)\';\n              cursorRef.current.style.backgroundColor = \'rgba(16, 185, 129, 0.9)\'; // emerald\n              cursorRef.current.style.borderColor = \'rgba(16, 185, 129, 1)\';\n          } else {\n              cursorRef.current.style.transform = \'translate(-50%, -50%) scale(1)\';\n              cursorRef.current.style.backgroundColor = \'rgba(255, 255, 255, 0.2)\';\n              cursorRef.current.style.borderColor = \'rgba(255, 255, 255, 0.8)\';\n          }\n      }\n\n      // PINCH DETECTION\n      if (distance < 0.06) {\n        setGesture(\'PINCH\');\n      } else if (distance > 0.15) {\n        setGesture(\'OPEN_HAND\');\n      } else {\n        setGesture(\'IDLE\'); \n      }\n\n      // SWIPE DETECTION (Time window approach for reliability)\n      if (now - lastGestureTime.current > 1000) { // 1 sec cooldown \n          historyRef.current.push({ x: currentX, y: hand[0].y, time: now });\n          // Keep only last 400ms buffer\n          historyRef.current = historyRef.current.filter(p => now - p.time < 400); \n          \n          if (historyRef.current.length > 1) {\n              const oldest = historyRef.current[0];\n              const dx = currentX - oldest.x;\n              \n              if (dx > 0.12) { \n                  // If camera mirrors, moving hand left raises cursor.x, meaning positive dx\n                  setGesture(\'SWIPE_LEFT\');\n                  lastGestureTime.current = now;\n                  historyRef.current = [];\n              } else if (dx < -0.12) {\n                  setGesture(\'SWIPE_RIGHT\');\n                  lastGestureTime.current = now;\n                  historyRef.current = [];\n              }\n          }\n      }\n      \n    } else {\n      setGesture(\'IDLE\');\n      historyRef.current = [];\n      if (cursorRef?.current) cursorRef.current.style.opacity = \'0\';\n    }\n  }, [cursorRef]);"
      }
