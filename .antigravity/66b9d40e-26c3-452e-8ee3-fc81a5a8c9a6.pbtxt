      replacement_content: "    const response = await aiClient.models.generateContent({\n      model: \'gemini-2.5-flash\',\n      contents: prompt,\n      config: {\n        tools: [{ googleSearch: {} }], // Enable grounding via Google Search\n        temperature: 0.3,\n      }\n    });\n\n    const text = response.text || \"No se encontr\303\263 informaci\303\263n t\303\251cnica detallada.\";\n    \n    // Extract search chunks/uris if available (metadata mapping depends on exact SDK response structure, keeping it safe)\n    res.json({ info: text });\n  } catch (error: any) {\n    console.error(\"Gemini API Error:\", error);\n    let errorMessage = \"Error de conexi\303\263n al buscar informaci\303\263n adicional.\";\n    if (error.status === 429 || (error.message && error.message.includes(\"429\")) || (error.message && error.message.includes(\"quota\"))) {\n      errorMessage = \"La API de Inteligencia Artificial est\303\241 saturada en este momento (L\303\255mite de cuota excedido). La b\303\272squeda din\303\241mica se reactivar\303\241 pronto.\";\n    }\n    // Return graceful fallback info instead of 500 so UI displays it nicely\n    res.status(200).json({ info: errorMessage });\n  }"
