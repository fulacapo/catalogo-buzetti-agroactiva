  file_change {
    absolute_path_uri: "file:///server.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import express from \'express\';\nimport path from \'path\';\nimport { GoogleGenAI } from \'@google/genai\';\nimport { createServer as createViteServer } from \'vite\';\nimport dotenv from \'dotenv\';\nimport db from \'./src/data/db.json\';\n\ndotenv.config();\n\nconst app = express();\nconst PORT = 3000;\n\napp.use(express.json());\n\n// Initialize Gemini Client Lazy to avoid startup crashes if key is missing\nlet ai: GoogleGenAI | null = null;\nfunction getAI() {\n  if (!ai) {\n    if (!process.env.GEMINI_API_KEY) {\n      console.warn(\"GEMINI_API_KEY NOT SET - Enrich feature will return placeholders.\");\n      return null;\n    }\n    ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });\n  }\n  return ai;\n}\n\n// API Route to fetch enriched data via Gemini + Google Search\napp.post(\'/api/enrich\', async (req, res) => {\n  try {\n    const { productName, code } = req.body;\n    if (!productName) {\n      return res.status(400).json({ error: \'Product name required\' });\n    }\n\n    const aiClient = getAI();\n    if (!aiClient) {\n      return res.json({ \n        info: \"Informaci\303\263n adicional no disponible. Configure la API Key de Gemini para activar la b\303\272squeda en vivo.\",\n        sources: [] \n      });\n    }\n\n    // Proactive debugging: Ensure we catch API errors gracefully.\n    const prompt = `Busca informaci\303\263n t\303\251cnica real en internet sobre el siguiente repuesto de inyecci\303\263n diesel: \"${productName}\" (C\303\263digo de referencia: ${code || \'N/A\'}).\nResponde con un p\303\241rrafo conciso (m\303\241ximo 3 oraciones) describiendo su funci\303\263n principal en motores y en qu\303\251 contextos es cr\303\255tico su mantenimiento. \nNo repitas que es un repuesto, ve directo a lo t\303\251cnico.`;\n\n    const response = await aiClient.models.generateContent({\n      model: \'gemini-2.5-pro\',\n      contents: prompt,\n      config: {\n        tools: [{ googleSearch: {} }], // Enable grounding via Google Search\n        temperature: 0.3,\n      }\n    });\n\n    const text = response.text || \"No se encontr\303\263 informaci\303\263n t\303\251cnica detallada.\";\n    \n    // Extract search chunks/uris if available (metadata mapping depends on exact SDK response structure, keeping it safe)\n    res.json({ info: text });\n  } catch (error: any) {\n    console.error(\"Gemini API Error:\", error);\n    res.status(500).json({ error: error.message || \'Failed to fetch external info\' });\n  }\n});\n\n// API Route to fetch product catalog\napp.get(\'/api/products\', (req, res) => {\n  // Convert the object map into an array for easier frontend mapping\n  const productArray = Object.values(db.productos);\n  res.json({ metadata: db.metadata, products: productArray });\n});\n\nasync function startServer() {\n  if (process.env.NODE_ENV !== \'production\') {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.join(process.cwd(), \'dist\');\n    app.use(express.static(distPath));\n    app.get(\'*\', (req, res) => {\n      res.sendFile(path.join(distPath, \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`Server running on http://localhost:${PORT}`);\n  });\n}\n\nstartServer();"
    }
