    replacement_chunks {
      replacement_content: "import { useRef, useState, useMemo } from \'react\';\nimport { useFrame, useThree } from \'@react-three/fiber\';\nimport { Text, Image as DreiImage, Float } from \'@react-three/drei\';\nimport * as THREE from \'three\';\n\ninterface SceneProps {\n  products: any[];\n  activeIndex: number;\n}\n\nexport function Scene({ products, activeIndex }: SceneProps) {\n  const { width } = useThree((state) => state.viewport);\n  const groupRef = useRef<THREE.Group>(null);\n  \n  // Smoothly interpolate the carousel rotation/position based on activeIndex\n  useFrame((state, delta) => {\n    if (groupRef.current) {\n      // Calculate target X position for the group to center the active item\n      const targetX = -activeIndex * (width > 8 ? 6 : width * 0.7); \n      // Lerp for smooth sliding\n      groupRef.current.position.x = THREE.MathUtils.lerp(groupRef.current.position.x, targetX, 5 * delta);\n    }\n  });\n\n  const spacing = width > 8 ? 6 : width * 0.7;\n\n  return (\n    <group ref={groupRef}>\n      {products.map((product, index) => (\n        <ProductCard \n          key={product.codigo} \n          product={product} \n          position={[index * spacing, 0, 0]} \n          isActive={index === activeIndex}\n        />\n      ))}\n    </group>\n  );\n}\n\nfunction ProductCard({ product, position, isActive }: { product: any, position: [number, number, number], isActive: boolean }) {\n  const cardRef = useRef<THREE.Mesh>(null);\n  \n  // Hover/Active logic interpolation\n  useFrame((state, delta) => {\n    if (cardRef.current) {\n      const targetScale = isActive ? 1.1 : 0.8;\n      const targetZ = isActive ? 1 : 0;\n      \n      cardRef.current.scale.setScalar(\n        THREE.MathUtils.lerp(cardRef.current.scale.x, targetScale, 4 * delta)\n      );\n      \n      cardRef.current.position.z = THREE.MathUtils.lerp(\n        cardRef.current.position.z, targetZ, 4 * delta\n      );\n\n      if (isActive) {\n         // Subtle rotation for active item\n         cardRef.current.rotation.y = Math.sin(state.clock.elapsedTime) * 0.1;\n      } else {\n         cardRef.current.rotation.y = THREE.MathUtils.lerp(cardRef.current.rotation.y, 0, 4 * delta);\n      }\n    }\n  });\n\n  // Since we don\'t have the actual images guaranteed the file system, \n  // we will try to load from a public path, but use a colorful fallback plane if missing.\n  // We\'ll rely heavily on styling.\n  \n  const materialColor = useMemo(() => {\n     const colors = [\'#1e293b\', \'#334155\', \'#0f172a\', \'#1e1b4b\'];\n     return colors[Math.floor(Math.random() * colors.length)];\n  }, []);\n\n  return (\n    <Float floatIntensity={isActive ? 2 : 0.5} rotationIntensity={isActive ? 0.5 : 0.1}>\n      <group position={position}>\n        <mesh ref={cardRef}>\n          <planeGeometry args={[4, 5.5, 32, 32]} />\n          <meshStandardMaterial \n            color={materialColor}\n            roughness={0.2}\n            metalness={0.8}\n            envMapIntensity={1}\n          />\n          \n          {/* Card Content - Text overlay mapping */}\n          <Text\n             position={[0, 1.5, 0.02]}\n             fontSize={0.4}\n             color=\"white\"\n             anchorX=\"center\"\n             anchorY=\"middle\"\n             maxWidth={3.5}\n             textAlign=\"center\"\n             font=\"https://fonts.gstatic.com/s/spacegrotesk/v15/V8mQoQDjQSkGpu8pnHXFAA.woff\"\n          >\n             {product.codigo}\n          </Text>\n          \n          <Text\n             position={[0, 0, 0.02]}\n             fontSize={0.25}\n             color=\"#94a3b8\" // Slate 400\n             anchorX=\"center\"\n             anchorY=\"middle\"\n             maxWidth={3.5}\n             textAlign=\"center\"\n             font=\"https://fonts.gstatic.com/s/inter/v12/UcCO3FwrK3iLTeHuS_fvQtMwCp50KnMw2boKoduKmMEVuLyfAZ9hjp-Ek-_EeA.woff\"\n          >\n             {product.descripcion}\n          </Text>\n          \n           <Text\n             position={[0, -2, 0.02]}\n             fontSize={0.15}\n             color=\"#cbd5e1\"\n             anchorX=\"center\"\n             anchorY=\"middle\"\n             font=\"https://fonts.gstatic.com/s/jetbrainsmono/v18/tDbY2o-flEEny0FZhsfKu5WU4zr3E_BX0PnT8RD8yKwI.woff\"\n          >\n             {isActive ? \"PINCH TO VIEW DETAILS\" : \"\"}\n          </Text>\n        </mesh>\n      </group>\n    </Float>\n  );\n}"
    }
