  file_change {
    absolute_path_uri: "file:///src/hooks/useHandTracking.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useEffect, useRef, useState, useCallback } from \'react\';\nimport { FilesetResolver, HandLandmarker, HandLandmarkerResult } from \'@mediapipe/tasks-vision\';\n\nexport type GestureType = \'IDLE\' | \'SWIPE_LEFT\' | \'SWIPE_RIGHT\' | \'PINCH\' | \'OPEN_HAND\';\n\ninterface Point { x: number; y: number; z: number }\n\nexport function useHandTracking() {\n  const videoRef = useRef<HTMLVideoElement>(null);\n  const [gesture, setGesture] = useState<GestureType>(\'IDLE\');\n  const [isInitializing, setIsInitializing] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n\n  const landmarkerRef = useRef<HandLandmarker | null>(null);\n  const animationFrameRef = useRef<number | null>(null);\n  const prevPositionRef = useRef<{ x: number, time: number } | null>(null);\n\n  // Initialize MediaPipe HandLandmarker\n  useEffect(() => {\n    let active = true;\n\n    async function init() {\n      try {\n        const vision = await FilesetResolver.forVisionTasks(\n          \"https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.3/wasm\"\n        );\n        \n        if (!active) return;\n\n        const landmarker = await HandLandmarker.createFromOptions(vision, {\n          baseOptions: {\n            modelAssetPath: \"https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task\",\n            delegate: \"GPU\"\n          },\n          runningMode: \"VIDEO\",\n          numHands: 1\n        });\n        \n        if (!active) return;\n        landmarkerRef.current = landmarker;\n        setIsInitializing(false);\n      } catch (err: any) {\n        console.error(\"Failed to initialize hand tracking:\", err);\n        setError(err.message || \"Failed to initialize MediaPipe\");\n        setIsInitializing(false);\n      }\n    }\n\n    init();\n\n    return () => {\n      active = false;\n      if (landmarkerRef.current) {\n        landmarkerRef.current.close();\n      }\n    };\n  }, []);\n\n  // Detect gestures based on landmarks\n  const processLandmarks = useCallback((result: HandLandmarkerResult) => {\n    if (result.landmarks.length > 0) {\n      const hand = result.landmarks[0];\n      \n      // Calculate distance between thumb tip (4) and index finger tip (8)\n      const thumbTip = hand[4];\n      const indexTip = hand[8];\n      \n      const distance = Math.sqrt(\n        Math.pow(thumbTip.x - indexTip.x, 2) + \n        Math.pow(thumbTip.y - indexTip.y, 2)\n      );\n\n      const currentTime = Date.now();\n      const currentX = hand[0].x; // Wrist position X\n\n      // SWIPE DETECTION\n      if (prevPositionRef.current) {\n        const dx = currentX - prevPositionRef.current.x;\n        const dt = currentTime - prevPositionRef.current.time;\n        const velocity = dx / dt;\n        \n        // Only trigger swipe if velocity is high and enough time passed since last swipe\n        if (Math.abs(velocity) > 0.003 && dt > 200) {\n          if (velocity < -0.003) { // Hand moved left (mirrored camera could affect this, we assume standard representation)\n             setGesture(\'SWIPE_LEFT\');\n             prevPositionRef.current = { x: currentX, time: currentTime };\n             return;\n          } else if (velocity > 0.003) { // Hand moved right\n             setGesture(\'SWIPE_RIGHT\');\n             prevPositionRef.current = { x: currentX, time: currentTime };\n             return; // Debounce\n          }\n        }\n      }\n      \n      // PINCH DETECTION\n      if (distance < 0.05) {\n        setGesture(\'PINCH\');\n      } else if (distance > 0.15) {\n        setGesture(\'OPEN_HAND\');\n      } else {\n        setGesture(\'IDLE\'); // Revert to idle if nothing else \n      }\n\n      // Update prev position continuously for smooth velocity tracking, unless we just triggered a swipe\n      if (!prevPositionRef.current || (currentTime - prevPositionRef.current.time) > 50) {\n         prevPositionRef.current = { x: currentX, time: currentTime };\n      }\n      \n    } else {\n      setGesture(\'IDLE\');\n      prevPositionRef.current = null;\n    }\n  }, []);\n\n  // Set up camera and processing loop\n  useEffect(() => {\n    if (isInitializing || error) return;\n    \n    let active = true;\n\n    async function startCamera() {\n      try {\n        const stream = await navigator.mediaDevices.getUserMedia({ \n          video: { width: 640, height: 480, facingMode: \"user\" } \n        });\n        \n        if (videoRef.current && active) {\n          videoRef.current.srcObject = stream;\n          videoRef.current.addEventListener(\'loadeddata\', predictWebcam);\n        }\n      } catch (err: any) {\n        console.error(\"Camera error:\", err);\n        setError(\"Error accessing webcam. Please allow permissions.\");\n      }\n    }\n\n    let lastVideoTime = -1;\n    function predictWebcam() {\n      if (!videoRef.current || !landmarkerRef.current || !active) return;\n      \n      const v = videoRef.current;\n      //@ts-ignore - Some browser implementations might not have this, but standard ones do\n      const startTimeMs = performance.now();\n      if (lastVideoTime !== v.currentTime) {\n        lastVideoTime = v.currentTime;\n        const results = landmarkerRef.current.detectForVideo(v, startTimeMs);\n        processLandmarks(results);\n      }\n      \n      animationFrameRef.current = requestAnimationFrame(predictWebcam);\n    }\n\n    startCamera();\n\n    return () => {\n      active = false;\n      if (animationFrameRef.current) {\n        cancelAnimationFrame(animationFrameRef.current);\n      }\n      if (videoRef.current?.srcObject) {\n        (videoRef.current.srcObject as MediaStream).getTracks().forEach(track => track.stop());\n      }\n      if (videoRef.current) {\n           videoRef.current.removeEventListener(\'loadeddata\', predictWebcam);\n      }\n    };\n  }, [isInitializing, error, processLandmarks]);\n\n  return { videoRef, gesture, isInitializing, error };\n}"
    }
